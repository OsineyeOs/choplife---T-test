{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright tsx scripts/browser_frontend_smoke.ts",
    "test:preview": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright tsx scripts/preview_iframe_forensics.ts",
    "test:qa": "tsx scripts/hostile_qa_audit.ts",
    "test:defects": "tsx scripts/verify_remediation_defects.ts",
    "test:shifts": "tsx scripts/verify_logout_and_shift.ts",
    "test:printers": "tsx scripts/verify_printer_hardware.ts",
    "test:accounting": "tsx scripts/verify_accounting_and_audit.ts",
    "test:inventory": "tsx scripts/verify_inventory_crud.ts",
    "test:gate": "tsx scripts/verify_production_release_gate.ts",
    "test:responsive": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright tsx scripts/reproduce_cart_and_template.ts",
    "test:ux": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright tsx scripts/verify_customer_friction_reduction.ts",
    "test:smoke": "tsx scripts/runtime_frontend_smoke.ts",
    "test:interfaces": "tsx scripts/verify_three_interfaces_and_rbac.ts",
    "test:cms": "tsx scripts/verify_cms_menu_and_roles.ts",
    "test:compliance": "tsx scripts/verify_staff_compliance_and_assets.ts",
    "test:directive": "tsx scripts/verify_master_directive.ts",
    "test:release": "PLAYWRIGHT_BROWSERS_PATH=/ms-playwright tsx scripts/verify_final_release_closure.ts",
    "test:features": "tsx scripts/verify_shift_reconciliation_and_stock_alerts.ts",
    "audit:quality": "tsx scripts/audit-code-quality.ts",
    "audit:code-quality": "tsx scripts/audit-code-quality.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^4.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
